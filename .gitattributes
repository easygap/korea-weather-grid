# Normalize repository text files to LF on every platform.
* text=auto eol=lf

# Keep script line endings explicit.
*.bat        text eol=crlf
*.cmd        text eol=crlf
gradlew      text eol=lf
*.geojson    text eol=lf
src/main/resources/static/data/geodata/manifest.json text eol=lf

# Preserve upstream three.js formatting without rewriting the vendored source.
src/main/resources/static/js/three/three.core.js whitespace=-space-before-tab

# Binary assets.
*.jar        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
