<%@ page pageEncoding="UTF-8" %>
<div class="app" data-context-path="${pageContext.request.contextPath}" data-base-date="${baseDate}" data-base-time="${baseTime}" data-file-name="${fileName}" data-data-domain="weather">

    <!-- Primary navigation and search surface -->
    <header class="topbar">
        <div class="brand" title="BORA · Korea Weather Grid">
            <h1 class="sr-only">BORA 한국 기상 격자지도</h1>

            <svg width="32" height="32" viewBox="0 0 64 64" aria-hidden="true">
                <line x1="18.5" y1="8" x2="18.5" y2="56" stroke="currentColor" stroke-width="4.6" stroke-linecap="round"/>
                <path d="M20 9 C 34 6, 47 11, 57.5 19.5 C 45 23, 32.5 28.5, 20 34 Z" fill="#978ff9"/>
            </svg>
            <div class="brand_txt">
                <strong>BORA</strong>
                <span>KOREA WEATHER GRID</span>
            </div>
        </div>

        <nav class="data_domain_nav" id="data_domain_nav" aria-label="데이터 영역">
            <button type="button" data-data-domain="weather" class="on" aria-pressed="true">기상</button>
            <button type="button" data-data-domain="air" aria-pressed="false">대기질</button>
            <button type="button" data-data-domain="traffic" aria-pressed="false">교통</button>
        </nav>

        <div class="explore_modes" id="explore_modes" role="group" aria-label="기상 요소">
            <button type="button" data-explore-mode="wind" class="on" aria-pressed="true"><strong>바람</strong></button>
            <button type="button" data-explore-mode="temperature" aria-pressed="false"><strong>기온</strong></button>
            <button type="button" data-explore-mode="precipitation" aria-pressed="false"><strong>강수·눈</strong></button>
            <button type="button" data-explore-mode="solar" aria-pressed="false"><strong>일사</strong></button>
            <button type="button" data-explore-mode="hazards" aria-pressed="false"><strong>위험기상</strong></button>
        </div>
        <div class="explore_mode_summary" id="explore_mode_summary" data-kind="예보" role="status" aria-live="polite">
            <strong>바람 흐름</strong><span>풍속 색상과 흐름선을 함께 표시합니다.</span>
        </div>

        <!-- 지점 검색 -->
        <div class="search-container">
            <form id="station_search_form" role="search" aria-label="대표 지역 검색">
                <label class="sr-only" for="station_query">지점별 예보 검색</label>
                <input type="search" class="station_query" id="station_query" name="station" autocomplete="off" spellcheck="false" placeholder="지역·지점 검색…" role="combobox" aria-autocomplete="list" aria-controls="suggestions" aria-describedby="station_search_status" aria-expanded="false">
                <div class="suggestions" id="suggestions" role="listbox" aria-label="검색 제안"></div>
                <p class="sr-only" id="station_search_status" role="status" aria-live="polite"></p>
                <button type="button" class="coordinate_search_button" id="coordinate_search_toggle" title="위경도 검색" aria-label="위경도 검색 열기" aria-controls="coordinate_search_dialog" aria-expanded="false" aria-haspopup="dialog"></button>
                <button type="submit" class="station_search_button" id="station_search_button" title="지점별 예보 검색" aria-label="지점별 예보 검색"></button>
            </form>
            <section class="coordinate_panel" id="coordinate_search_dialog" role="dialog" aria-labelledby="coordinate_search_title" style="display:none;">
                <h2 id="coordinate_search_title">위경도 검색</h2>
                <form id="coordinate_search_form">
                    <p><label for="coordinate_latitude">위도</label> <input type="number" class="coordinate_input" id="coordinate_latitude" name="latitude" inputmode="decimal" min="32" max="44" step="any" required autocomplete="off" placeholder="예: 37.5665"></p>
                    <p><label for="coordinate_longitude">경도</label> <input type="number" class="coordinate_input" id="coordinate_longitude" name="longitude" inputmode="decimal" min="122" max="134" step="any" required autocomplete="off" placeholder="예: 126.9780"></p>
                    <button type="button" class="coordinate_panel_close" aria-label="위경도 검색 닫기">✕</button>
                    <button type="submit" class="coordinate_lookup">검색</button>
                </form>
            </section>
        </div>

        <div class="top-actions">
            <button type="button" class="icon-btn" id="btn_3d" title="3D 지형 뷰" aria-label="3D 지형 뷰 열기" aria-controls="view3d" aria-haspopup="dialog" aria-expanded="false">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5z"/><path d="M3 7l9 5 9-5M12 12v10"/></svg>
                <span class="lbl">3D</span>
            </button>
            <button type="button" class="icon-btn" id="theme_toggle" title="다크/라이트 전환" aria-label="라이트 테마로 전환" aria-pressed="false">
                <svg class="ic-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                <svg class="ic-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
        </div>
    </header>
